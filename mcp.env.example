# NAMES OF THE SETTINGS THE SERVER READS. Save this file as .env.example in the mcp repo.
#
# The server does NOT load a .env file. Set these as environment variables in PowerShell
# (see README: Run locally), as Function App application settings, or under "Values"
# in local.settings.json (gitignored). Do not commit real keys.

# Function (host) keys, one per app. Keep secret.
WEBSEARCH_FUNCTION_KEY=PASTE_KEY_HERE
WIKISEARCH_FUNCTION_KEY=PASTE_KEY_HERE
ONTOLOGY_FUNCTION_KEY=PASTE_KEY_HERE

# Base URLs of the deployed Function Apps (defaults are built in; override if they change).
# WEBSEARCH_URL=https://websearch-h9arcweeftfrd8e0.eastus-01.azurewebsites.net
# WIKISEARCH_URL=https://wikisearch-gmebdbewaec6axdp.eastus-01.azurewebsites.net
# ONTOLOGY_URL=https://ontology-ghgedphdh6eefych.eastus-01.azurewebsites.net
# MCP_ONTOLOGY_URL=https://raw.githubusercontent.com/SujeethFoundation/ontology/main/ontology/ontology.json

# Azure GPT-6 Luna ontology resolution. The model deployment must support the Azure Responses API.
MCP_ONTOLOGY_MODEL_ENDPOINT=https://avisuj-4010-resource.services.ai.azure.com/openai/v1/responses
MCP_ONTOLOGY_MODEL_API_KEY=PASTE_KEY_HERE
# MCP_ONTOLOGY_MODEL_NAME=gpt-6-luna
# MCP_ONTOLOGY_MODEL_TIMEOUT_SECONDS=25
# MCP_ONTOLOGY_REASONING_EFFORT=low
# MCP_ONTOLOGY_MODEL_MAX_OUTPUT_TOKENS=600  # constrained JSON plan; keeps token usage proportional to the task
# MCP_ONTOLOGY_MODEL_MAX_CONCURRENCY=4      # model requests per MCP instance; queue excess calls
# MCP_ONTOLOGY_MODEL_RETRY_ATTEMPTS=3       # retry model 429s only, within the model timeout
# MCP_ONTOLOGY_MODEL_RETRY_MAX_WAIT_SECONDS=5
# MCP_ONTOLOGY_MODEL_CANDIDATE_LIMIT=8       # likely concepts sent to Luna before its one-hop relationship expansion
# MCP_ONTOLOGY_MODEL_RELATIONSHIP_LIMIT=24   # one-hop edges sent with a candidate packet
# MCP_ONTOLOGY_MODEL_DEFINITION_MAX_CHARS=240
# MCP_ONTOLOGY_PLAN_CACHE_SECONDS=300
# MCP_ONTOLOGY_PLAN_CACHE_MAX_ENTRIES=500

# Public-service behavior (defaults shown).
# MCP_ADMIN_TOOLS=false          # true shows check_services, resolve_ontology, get_ontology_context
# MCP_STATELESS=true
# MCP_RATE_LIMIT_PER_IP=120      # requests per minute per client address, 0 = off
# MCP_RATE_LIMIT_GLOBAL=600      # requests per minute in total, 0 = off

# Hosted AI assistants (Claude, ChatGPT, the Foundry agent) share a few addresses, so they count in their own bucket.
# MCP_RATE_LIMIT_TRUSTED_PER_IP=1200   # requests per minute per trusted address, 0 = off
# MCP_TRUSTED_RANGES=160.79.104.0/21   # Anthropic's published outbound range; comma-separated CIDRs, "none" clears it
# MCP_TRUSTED_RANGE_URLS=https://openai.com/chatgpt-connectors.json   # manifests of ranges, refreshed daily; "none" = off
# MCP_TRUSTED_REFRESH_SECONDS=86400
# MCP_TRUSTED_KEY=PASTE_A_LONG_RANDOM_VALUE   # the Foundry project sends this in the header below; keep secret
# MCP_TRUSTED_KEY_HEADER=x-mcp-client-key
# MCP_TRUSTED_USER_AGENTS=openai-mcp         # optional regex; a User-Agent can be faked, so it only picks the bucket
# MCP_REQUEST_TIMEOUT=30
# MCP_RETRY_ATTEMPTS=4                  # tries for a backend call refused with 503 or unreachable; a read timeout is not retried (1 = off)
# MCP_RETRY_DEFAULT_WAIT_SECONDS=3       # wait when a 503 has no Retry-After
# MCP_PLAN_STORE_SECONDS=3600            # shared plan table: how long another instance's plan is reused (0 = off)
# MCP_ANSWER_STORE_SECONDS=3600         # shared website-search answers keyed by plan (0 = off)
# MCP_ANSWER_FALLBACK_SIMILARITY=0.90,0.85  # search app failing: answer from the nearest earlier question's stored search (0.90 after 1st failure, 0.85 after 2nd; empty = off)
# MCP_TRY_TIMEOUT_SECONDS=20             # one try of a backend call; sends X-Request-Budget-Ms (match SEARCH_DEADLINE_SECONDS)
# MCP_PLAN_STORE_CONNECTION=             # storage connection string (default: AzureWebJobsStorage)
# MCP_RETRY_SHRINK_QUERIES=true          # retry an overloaded search app with one query fewer (min 1)
# MCP_RETRY_MAX_WAIT_SECONDS=8           # longest single wait
# MCP_RETRY_MIN_ATTEMPT_SECONDS=4        # a retry needs at least this much timeout left after the wait

# Search diversity (defaults shown).
# SEARCH_RESULT_COUNT=10         # ordinary results returned; best bets and spotlights come on top
# SEARCH_CANDIDATE_POOL=20       # website candidates requested before choosing (the Search App returns at most SEARCH_MAX_LIMIT, 20)
# MAX_RESULTS_PER_DOMAIN=2       # most results from any one source; one per source is picked first
# FULL_DOCUMENT_CHAR_BUDGET=60000  # total characters of full document text per response

# Listening address. On Azure the host is detected automatically (0.0.0.0).
# MCP_HOST=127.0.0.1
# On Azure Functions set MCP_PORT=8000 as an app setting; it must match "port" in host.json.
# MCP_PORT=8000

# Tool calls run on worker threads so the event loop stays free (see README).
# MCP_TOOL_THREADS=32            # tool calls in progress at once in one instance

# AZURE_OPENAI_ENDPOINT=                # embedding resource, same as the search app
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=sf-embeddings
# MCP_PLAN_REUSE_SIMILARITY=0            # 0 = only log how similar questions' plans compare; 0.95 = reuse at or above it
