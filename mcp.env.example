# NAMES OF THE SETTINGS THE SERVER READS. Save this file as .env.example in the mcp repo.
#
# The server does NOT load a .env file. Set these as environment variables in PowerShell
# (see README: Run locally), as Function App application settings, or under "Values"
# in local.settings.json (gitignored). Do not commit real keys.

# Function (host) keys, one per app. Keep secret.
WEBSEARCH_FUNCTION_KEY=PASTE_KEY_HERE
WIKISEARCH_FUNCTION_KEY=PASTE_KEY_HERE
ONTOLOGY_FUNCTION_KEY=PASTE_KEY_HERE

# Base URLs of the deployed Function Apps (defaults are built in; override if they change).
# WEBSEARCH_URL=https://websearch-h9arcweeftfrd8e0.eastus-01.azurewebsites.net
# WIKISEARCH_URL=https://wikisearch-gmebdbewaec6axdp.eastus-01.azurewebsites.net
# ONTOLOGY_URL=https://ontology-ghgedphdh6eefych.eastus-01.azurewebsites.net

# Public-service behavior (defaults shown).
# MCP_ADMIN_TOOLS=false          # true shows check_services, resolve_ontology, get_ontology_context
# MCP_STATELESS=true
# MCP_RATE_LIMIT_PER_IP=120      # requests per minute per client address, 0 = off
# MCP_RATE_LIMIT_GLOBAL=600      # requests per minute in total, 0 = off

# Hosted AI assistants (Claude, ChatGPT, the Foundry agent) share a few addresses, so they count in their own bucket.
# MCP_RATE_LIMIT_TRUSTED_PER_IP=1200   # requests per minute per trusted address, 0 = off
# MCP_TRUSTED_RANGES=160.79.104.0/21   # Anthropic's published outbound range; comma-separated CIDRs, "none" clears it
# MCP_TRUSTED_RANGE_URLS=https://openai.com/chatgpt-connectors.json   # manifests of ranges, refreshed daily; "none" = off
# MCP_TRUSTED_REFRESH_SECONDS=86400
# MCP_TRUSTED_KEY=PASTE_A_LONG_RANDOM_VALUE   # the Foundry project sends this in the header below; keep secret
# MCP_TRUSTED_KEY_HEADER=x-mcp-client-key
# MCP_TRUSTED_USER_AGENTS=openai-mcp         # optional regex; a User-Agent can be faked, so it only picks the bucket
# MCP_REQUEST_TIMEOUT=30

# Search diversity (defaults shown).
# SEARCH_RESULT_COUNT=10         # ordinary results returned; best bets and spotlights come on top
# SEARCH_CANDIDATE_POOL=50       # website candidates requested before choosing
# MAX_RESULTS_PER_DOMAIN=2       # most results from any one source; one per source is picked first
# FULL_DOCUMENT_CHAR_BUDGET=60000  # total characters of full document text per response

# Listening address. On Azure the host is detected automatically (0.0.0.0).
# MCP_HOST=127.0.0.1
# On Azure Functions set MCP_PORT=8000 as an app setting; it must match "port" in host.json.
# MCP_PORT=8000

# Tool calls run on worker threads so the event loop stays free (see README).
# MCP_TOOL_THREADS=32            # tool calls in progress at once in one instance
