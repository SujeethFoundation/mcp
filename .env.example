# Copy this file to .env and fill in your own rotated keys.

# Your deployed Azure Wiki Search Function endpoint (no query string).
WIKI_SEARCH_URL=https://wikisearch-gmebdbewaec6axdp.eastus-01.azurewebsites.net/api/search

# Azure Function key. Keep this secret; do not commit .env.
WIKI_SEARCH_FUNCTION_KEY=PASTE_ROTATED_AZURE_FUNCTION_KEY_HERE

# LangSearch API key. Keep this secret; do not commit .env.
LANGSEARCH_API_KEY=PASTE_ROTATED_LANGSEARCH_API_KEY_HERE

# Local MCP server settings.
MCP_HOST=127.0.0.1
MCP_PORT=8000
